* text=auto eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.png  binary
*.jpg  binary
*.ico  binary
*.gif    binary
*.webp   binary
*.svg    text eol=lf
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.mp4    binary
*.mov    binary
*.zip    binary
*.gz     binary
*.pdf    binary

# Whitespace policy for `git diff --check` (CI Policy gates). Two trailing
# spaces are a Markdown hard line break, and vendored license texts are kept
# byte-for-byte as published.
*.md whitespace=-blank-at-eol
apps/desktop/src/renderer/src/assets/fonts/**/LICENSE.txt -whitespace
